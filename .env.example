# 此 MCP 进程可访问的 DeepTutor API 地址。
DEEPTUTOR_BASE_URL=http://127.0.0.1:8001
DEEPTUTOR_TIMEOUT=20
DEEPTUTOR_MCP_TIMEZONE=UTC

# 远程 Streamable HTTP 服务。密钥文件应保存在仓库之外。
DEEPTUTOR_MCP_API_KEY_FILE=/path/to/private/mcp-api-key
DEEPTUTOR_KB_ROOT=/path/to/DeepTutor/data/knowledge_bases
DEEPTUTOR_MCP_PUBLIC_HOST=mcp.example.net
DEEPTUTOR_MCP_LOCAL_URL=http://127.0.0.1:8000
DEEPTUTOR_MCP_PUBLIC_URL=https://mcp.example.net

# 可选：为不同客户端配置独立 API 密钥。Poke 用户标识请求头可设为 X-Poke-User-Id。
# DEEPTUTOR_MCP_CLIENT_KEYS_FILE=/path/to/private/client-keys.json
# DEEPTUTOR_MCP_CLIENT_ID_HEADER=X-Client-Id

# 可选：验证可信 OAuth 网关添加的签名身份断言。
# 网关必须验证用户的 OAuth 会话，并覆盖同名的入站请求头。
# MCP 服务会验证 JWT 签名、签发方、受众、有效期和用户身份。
# DEEPTUTOR_MCP_PROXY_JWT_HOST=mcp.example.net
# DEEPTUTOR_MCP_PROXY_JWT_HEADER=cf-access-jwt-assertion
# DEEPTUTOR_MCP_PROXY_JWT_ISSUER=https://your-team.example-idp.com
# DEEPTUTOR_MCP_PROXY_JWT_JWKS_URL=https://your-team.example-idp.com/.well-known/jwks.json
# DEEPTUTOR_MCP_PROXY_JWT_AUDIENCE=your-resource-audience
# DEEPTUTOR_MCP_PROXY_JWT_IDENTITY_CLAIM=email
# DEEPTUTOR_MCP_PROXY_JWT_ALLOWED_SUBJECT=you@example.net

# 可选：通过 SSH 在另一台机器上进行向量检索，或直接调用 DeepTutor 对话。
# DEEPTUTOR_SSH_TARGET=user@deeptutor-host
# DEEPTUTOR_REMOTE_CLI=/path/to/deeptutor
# DEEPTUTOR_REMOTE_HOME=/path/to/DeepTutor
# DEEPTUTOR_TURN_TIMEOUT=240
