[Unit]
Description=DeepTutor MCP remote server
After=network-online.target
Wants=network-online.target
# Add this when the knowledge base lives on a separate mount:
# RequiresMountsFor=/path/to/knowledge-base-storage

[Service]
Type=simple
User=YOUR_SERVICE_USER
WorkingDirectory=/path/to/deeptutor-mcp
EnvironmentFile=/path/to/private/deeptutor-mcp.env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
ExecStart=/path/to/python -m uvicorn remote_mcp:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
